{
	"name": "ds_bronze_csv",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_adls_olist",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"nombre_archivo": {
				"type": "string"
			},
			"carpeta": {
				"type": "string",
				"defaultValue": "olist"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().nombre_archivo",
					"type": "Expression"
				},
				"folderPath": "@dataset().carpeta",
				"fileSystem": "bronze"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}