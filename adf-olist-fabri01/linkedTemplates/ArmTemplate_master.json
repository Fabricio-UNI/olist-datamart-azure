{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-olist-fabri01"
		},
		"ls_adls_olist_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stolistfabri01.dfs.core.windows.net/"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-olist-fabri01.vault.azure.net/"
		},
		"ls_sql_olist_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-olist-fabri01.database.windows.net"
		},
		"ls_sql_olist_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "olist_oro"
		},
		"ls_synapse_olist_properties_typeProperties_endpoint": {
			"type": "string",
			"defaultValue": "https://syn-olist-fabri01.dev.azuresynapse.net"
		},
		"tr_diario_2am_properties_pl_olist_completo_parameters_tablas": {
			"type": "array",
			"defaultValue": [
				"orders",
				"order_items",
				"payments",
				"products",
				"category_translation",
				"sellers",
				"customers"
			]
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-olist-fabri01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_olist_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_olist_properties_typeProperties_url')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_sql_olist_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_olist_properties_typeProperties_server')]"
					},
					"ls_sql_olist_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_olist_properties_typeProperties_database')]"
					},
					"ls_synapse_olist_properties_typeProperties_endpoint": {
						"value": "[parameters('ls_synapse_olist_properties_typeProperties_endpoint')]"
					},
					"tr_diario_2am_properties_pl_olist_completo_parameters_tablas": {
						"value": "[parameters('tr_diario_2am_properties_pl_olist_completo_parameters_tablas')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}